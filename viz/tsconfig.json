{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // Relative imports in vite.config.ts's module graph carry explicit `.ts`
    // extensions so Vite's `configLoader: 'native'` (Node type-stripping, the
    // planned default in a future major) can load the config. Requires noEmit.
    // See FE-090.3. UI modules keep bare specifiers — they are bundled, not
    // loaded natively.
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "strict": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
